# Postgres (used by docker-compose.yml and apps/api)
POSTGRES_USER=ccip
POSTGRES_PASSWORD=ccip_dev_password
POSTGRES_DB=ccip
POSTGRES_PORT=5432

# apps/api
DATABASE_URL="postgresql://ccip:ccip_dev_password@localhost:5432/ccip?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Seed admin user (used by apps/api/prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@ccip.local"
SEED_ADMIN_PASSWORD="Admin@12345"

# Microsoft Entra ID (Azure AD) app registration — leave both unset to
# disable Microsoft sign-in entirely; local login keeps working regardless.
MICROSOFT_CLIENT_ID=""
ALLOWED_EMAIL_DOMAIN="tatacommunications.com"
DEFAULT_SSO_ROLE="VIEWER"

# apps/web
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api"
# Must match MICROSOFT_CLIENT_ID above.
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=""
