DATABASE_URL="postgresql://ccip:ccip_dev_password@localhost:5432/ccip?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"
API_PORT=4000

# Microsoft Entra ID (Azure AD) app registration — POST /auth/microsoft
# validates ID tokens against this client ID and Microsoft's own JWKS.
# Leave unset to disable Microsoft sign-in entirely (local login keeps
# working regardless).
MICROSOFT_CLIENT_ID=""
ALLOWED_EMAIL_DOMAIN="tatacommunications.com"
DEFAULT_SSO_ROLE="VIEWER"

# Leave unset to reflect the incoming request origin (e.g. in Codespaces,
# where the web app's URL isn't known ahead of time). Set a comma-separated
# list to lock CORS down for production.
WEB_ORIGIN=

# Used by prisma/seed.ts
SEED_ADMIN_EMAIL="admin@ccip.local"
SEED_ADMIN_PASSWORD="Admin@12345"
