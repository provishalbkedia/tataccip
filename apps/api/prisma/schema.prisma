generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum AuthProvider {
  LOCAL
  MICROSOFT
}

enum ServiceName {
  SCCP
  DSX
  IPX
}

enum DiscrepancyType {
  MISSING_IN_REACHLIST
  MISSING_IN_IR21
  PROVIDER_MISMATCH
}

enum UploadStatus {
  SUCCESS
  PARTIAL
  FAILED
}

enum VariantStatus {
  PENDING
  RESOLVED
  IGNORED
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  // Sentinel "SSO_MANAGED_MICROSOFT" for authProvider=MICROSOFT accounts —
  // never a real bcrypt hash, and POST /auth/login's bcrypt.compare against
  // it will simply never match, so a Microsoft-provisioned account can't
  // accidentally be signed into via the local password form.
  passwordHash String
  role         Role      @default(VIEWER)
  name         String?
  // Toggled off by an admin (PUT /users/:id/status) to suspend access
  // without deleting the account — enforced in JwtStrategy.validate() on
  // every request, not just at login, so revocation takes effect
  // immediately rather than waiting for the JWT to expire.
  isActive     Boolean      @default(true)
  authProvider AuthProvider @default(LOCAL)
  createdAt    DateTime  @default(now())
  // Updated (fire-and-forget, not awaited) on every authenticated request
  // by JwtStrategy — powers the "N Online" header badge. Stored on User
  // rather than in-memory: Cloud Run can run multiple container instances
  // and scale to zero, so in-memory presence tracking wouldn't be
  // consistent across instances the way a shared DB column is.
  lastActiveAt DateTime?

  loginHistory LoginHistory[]
}

// One row per successful login — JWT auth is stateless (no session table,
// nothing invalidates a prior token), so this is purely an activity log,
// not an access-control mechanism. ipAddress/userAgent are best-effort: a
// browser never exposes the client's actual machine name to a web app, so
// this is the closest real substitute for "where did this login come from".
model LoginHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  loginAt   DateTime @default(now())
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model MnoMaster {
  id           Int      @id @default(autoincrement())
  operatorName String
  country      String
  mcc          String
  mnc          String
  countryCode  String
  tadigCode    String   @unique
  // Alternate/legacy TADIGs known to belong to this same operator (e.g. a
  // second TADIG issued for a merger or a separate radio-generation
  // license) — curated by an admin via PATCH /mno/:id/secondary-tadigs,
  // not auto-derived: a GSMA IR.21 XML declares exactly one TADIG per
  // file, so there's no reliable signal to infer this relationship from
  // ingestion alone. Reach List uploads resolve against tadigCode OR this
  // list, so a reach list quoting only the legacy TADIG still attaches to
  // the right operator instead of spawning a duplicate MnoMaster row.
  secondaryTadigs String[] @default([])
  status       String   @default("ACTIVE")
  createdDate  DateTime @default(now())

  ir21Entries      Ir21Connectivity[]
  reachlistEntries ProviderReachlist[]
  discrepancies    DataDiscrepancy[]
  connectivity     MnoMasterConnectivity?
  providerOverrides MnoProviderOverride[]
  normalizationAudits MnoNormalizationAudit[]

  @@index([operatorName])
  @@index([country])
}

// Wide denormalized per-MNO snapshot of the last-parsed IR.21 XML file,
// beyond what the narrow (MNO, service) -> provider model captures — kept
// alongside, not instead of, Ir21Connectivity (which the comparison engine
// still reads). Refreshed on every XML re-ingestion of that MNO's TADIG.
model MnoMasterConnectivity {
  id                      String    @id @default(uuid())
  mnoId                   Int       @unique
  tadigCode               String    @unique
  operatorName            String
  country                 String
  networkType             String?
  mccMncList              String[]
  primarySccpCarrier      String?
  backupSccpCarriers      String[]
  sccpPointCodes          String[]
  grxIpxProviders         String[]
  lteIpxProviders         String[]
  // The operator's own Autonomous System Number for BGP peering with its
  // GRX/IPX carrier(s) — declared once per MNO in the GRX/IPX routing
  // section, not per-provider (see Ir21XmlParserService).
  asNumber                String?
  interPmnIpRanges        String[]
  diameterEdgeAgentFqdn   String?
  authoritativeDnsIps     String[]
  epcRealms               String[]
  roamingCoordinatorEmail String?
  ts24x7Email             String?
  distributionEmail       String?
  xmlFileVersion          String?
  lastEffectiveDate       DateTime?
  lastParsedAt            DateTime  @default(now())

  // The original PDF, if one was paired with this MNO's XML in a ZIP
  // upload (matched by TADIG appearing in the PDF's filename). Stored in
  // Supabase Storage (pdfStoragePath is the object path within that
  // bucket) rather than local disk — Render/Cloud Run containers are
  // ephemeral, so anything written to local disk is lost on every
  // restart/redeploy.
  pdfFileName    String?
  pdfStoragePath String?
  pdfFileSize    Int?
  hasPdfDocument Boolean @default(false)

  mno MnoMaster @relation(fields: [mnoId], references: [id])
}

model ProviderMaster {
  id           Int     @id @default(autoincrement())
  providerName String  @unique
  providerType String?
  headquarters String?
  website      String?

  ir21Entries      Ir21Connectivity[]
  reachlistEntries ProviderReachlist[]
  discrepancies    DataDiscrepancy[]
  aliases          ProviderAlias[]
  unmappedVariants UnmappedProviderVariant[]
  overrides        MnoProviderOverride[]
  normalizationAudits MnoNormalizationAudit[]
}

// A known raw-string spelling of a provider name (from an IR.21 XML export,
// vendor tooling, etc.) mapped to its canonical ProviderMaster row. Looked up
// via ProviderResolverService's in-memory cache during XML ingestion.
model ProviderAlias {
  id           String   @id @default(uuid())
  providerId   Int
  aliasPattern String   @unique
  createdAt    DateTime @default(now())

  provider ProviderMaster @relation(fields: [providerId], references: [id])

  @@index([providerId])
}

// A raw carrier-name string encountered during XML ingestion that didn't
// match any known ProviderAlias. Queued for an admin to map to a
// ProviderMaster (or an existing one) via POST /provider-aliases/resolve,
// rather than auto-creating a ProviderMaster from unverified XML text.
model UnmappedProviderVariant {
  id                 String        @id @default(uuid())
  rawCarrierName     String
  normalizedPattern  String        @unique
  detectedService    ServiceName
  // Every distinct TADIG whose file contained this raw carrier-name string,
  // across the whole batch — not just the most recent one — so resolving
  // the variant can retroactively backfill all of them, not just one.
  affectedTadigs     String[]
  occurrenceCount    Int           @default(1)
  status             VariantStatus @default(PENDING)
  resolvedProviderId Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  resolvedProvider ProviderMaster? @relation(fields: [resolvedProviderId], references: [id])

  @@index([status])
}

enum MnoMatchStatus {
  EXACT_TADIG
  ALIAS_MATCHED
  PENDING_REVIEW
  MANUALLY_OVERRIDDEN
}

// GSMA IR.21 is the platform's sole authoritative source for new MNO
// records — Reach List ingestion no longer auto-creates a MnoMaster row
// for a TADIG it doesn't already recognize (see
// UploadService.ingestReachlistRowsRaw). A row that doesn't match an
// existing MnoMaster by exact TADIG (tadigCode or secondaryTadigs), or by
// a confident country+name fuzzy match, is queued here instead —
// ALIAS_MATCHED for the fuzzy-matched case (a paper trail for a judgment
// call, since it wasn't an exact TADIG hit) and PENDING_REVIEW for a
// genuine miss — so an admin can map it to the right existing MnoMaster,
// or confirm it's a genuinely new operator that needs its own IR.21
// upload, rather than the ingestion pipeline silently inflating the MNO
// count with an unverified reach-list citation.
model MnoNormalizationAudit {
  id              String         @id @default(uuid())
  rawOperatorName String         @default("")
  rawTadigCode    String         @default("")
  country         String         @default("")
  providerId      Int
  // Every service (SCCP/DSX/IPX) this raw row has declared, across every
  // upload that hit this same unresolved combination — not just the most
  // recent one, so resolving it later backfills every service, not one.
  affectedServices String[]      @default([])
  affectedFiles     String[]     @default([])
  occurrenceCount   Int          @default(1)
  matchStatus       MnoMatchStatus @default(PENDING_REVIEW)
  canonicalMnoId    Int?
  reasonNote        String?
  updatedBy         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  provider     ProviderMaster @relation(fields: [providerId], references: [id])
  canonicalMno MnoMaster?     @relation(fields: [canonicalMnoId], references: [id])

  @@unique([providerId, rawTadigCode, rawOperatorName])
  @@index([matchStatus])
}

// An admin-pinned (MNO, service) -> provider mapping that outlives normal
// alias resolution — for cases where a generic declared string ("SCCP
// Carrier", "IPX Provider") resolves the same way for every MNO that uses
// it, but a specific MNO's real relationship is actually with a different
// provider. Re-applied on every future IR.21 XML re-ingestion of that
// TADIG (see UploadService.applyParsedIr21), taking priority over whatever
// the file's own declared text would otherwise resolve to.
model MnoProviderOverride {
  id                 String      @id @default(uuid())
  tadigCode          String
  mnoId              Int
  serviceName        ServiceName
  overrideProviderId Int
  // The raw declared string this override replaces (e.g. "SCCP Carrier") —
  // kept for audit visibility, not used for matching.
  originalRawString String  @default("")
  reasonNote        String?
  updatedBy         String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  mno              MnoMaster      @relation(fields: [mnoId], references: [id])
  overrideProvider ProviderMaster @relation(fields: [overrideProviderId], references: [id])

  @@unique([tadigCode, serviceName])
  @@index([mnoId])
}

model Service {
  id          Int         @id @default(autoincrement())
  serviceName ServiceName @unique

  ir21Entries      Ir21Connectivity[]
  reachlistEntries ProviderReachlist[]
}

// One "current" IR.21-declared provider per (MNO, service) — mirrors the
// GSMA IR.21 document being the MNO's single published truth per service.
model Ir21Connectivity {
  id            Int      @id @default(autoincrement())
  mnoId         Int
  providerId    Int
  serviceId     Int
  sourceFile    String
  uploadDate    DateTime @default(now())
  effectiveDate DateTime
  remarks       String?
  // True when this row's providerId came from an active MnoProviderOverride
  // rather than normal alias resolution of the file's own declared text —
  // see UploadService.applyParsedIr21 and MnoProviderOverrideService.
  isManualOverride Boolean @default(false)

  mno      MnoMaster      @relation(fields: [mnoId], references: [id])
  provider ProviderMaster @relation(fields: [providerId], references: [id])
  service  Service        @relation(fields: [serviceId], references: [id])

  @@unique([mnoId, serviceId])
}

// Multiple providers may each independently claim the same (MNO, service)
// in their own reach list, so this is unique per (MNO, provider, service).
model ProviderReachlist {
  id            Int      @id @default(autoincrement())
  mnoId         Int
  providerId    Int
  serviceId     Int
  sourceFile    String
  uploadDate    DateTime @default(now())
  effectiveDate DateTime

  mno      MnoMaster      @relation(fields: [mnoId], references: [id])
  provider ProviderMaster @relation(fields: [providerId], references: [id])
  service  Service        @relation(fields: [serviceId], references: [id])

  @@unique([mnoId, providerId, serviceId])
}

model DataDiscrepancy {
  id              Int             @id @default(autoincrement())
  mnoId           Int
  providerId      Int?
  service         ServiceName
  ir21Status      String
  reachlistStatus String
  discrepancyType DiscrepancyType
  computedAt      DateTime        @default(now())

  mno      MnoMaster       @relation(fields: [mnoId], references: [id])
  provider ProviderMaster? @relation(fields: [providerId], references: [id])

  @@index([discrepancyType])
  @@index([service])
}

model UploadHistory {
  id            Int          @id @default(autoincrement())
  filename      String
  uploadTime    DateTime     @default(now())
  uploadedBy    String
  recordsLoaded Int
  status        UploadStatus
  errorLog      String?

  // Set only for an IR.21 XML batch uploaded with "Replace Active Dataset"
  // — at most one row has isCurrentActive true at a time (the admin
  // banner's source of truth for "what's the active baseline"). mnoCount
  // snapshots how many MNOs the replacement covered, for that same banner.
  isCurrentActive Boolean @default(false)
  mnoCount        Int?
}
