NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api"

# Microsoft Entra ID (Azure AD) app registration's Application (client) ID —
# must match the backend's MICROSOFT_CLIENT_ID. Leave unset to hide/disable
# the "Sign in with Microsoft" button (local login keeps working regardless).
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=""

# The app registration's Directory (tenant) ID -- Tata Communications is
# registered single-tenant, so MSAL authenticates straight against this
# tenant rather than the generic multi-tenant "organizations" endpoint.
# Leave unset to fall back to "organizations" (still works, just less
# precise; @tatacommunications.com is enforced server-side either way).
NEXT_PUBLIC_MICROSOFT_TENANT_ID=""
